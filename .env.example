# Server & Application Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL)
# Example: postgres://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgres://neondb_owner:password@ep-example-pooler.region.neon.tech/neondb?sslmode=require

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Initial Landlord Admin Credentials (Used for seed/initial setup)
ADMIN_EMAIL=landlord@example.com
ADMIN_DEFAULT_PASSWORD=ChangeMeOnFirstLogin123!

# Cloudinary Storage (Tenant Aadhaar & Profile Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client App / Android Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
